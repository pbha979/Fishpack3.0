@page
@model ChangePasswordModel
@{
    ViewData["Title"] = Model.IsRequired ? "Du må bytte passord" : "Bytt passord";
    Layout = "_AccountLayout";
}

@if (Model.IsRequired)
{
    <div class="alert alert-warning" role="alert">
        Passordet ditt må byttes før du får tilgang til FishPack.
    </div>
}

<p class="account-intro">
    Passordet må ha minst @UserService.MinimumPasswordLength tegn og inneholde store bokstaver,
    små bokstaver og tall.
</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.CurrentPassword" class="form-label">Nåværende passord</label>
        <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="Input.CurrentPassword" class="validation-message"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">Nytt passord</label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="validation-message"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Bekreft nytt passord</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Lagre nytt passord</button>
</form>

@if (!Model.IsRequired)
{
    <a class="account-secondary-link" href="~/">Tilbake til FishPack</a>
}
